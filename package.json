{
  "name": "@atc-web/atc-render",
  "version": "1.20.0",
  "private": true,
  "description": "PDF rendering from versioned JSON layout templates: headings, text with placeholders, tables across pages, images, QR codes; streamed or stored in media",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/atc-render.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@atc-web/atc-service-core": "github:alitalipcalikoglu/atc-service-core#v1.20.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/pdfkit": "0.17.6",
    "typescript": "7.0.2"
  }
}
