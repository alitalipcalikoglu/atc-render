# --- Server ---
PORT=3015
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Request body cap: layout + data + base64 images. 4 MiB default.
BODY_LIMIT=4194304

# --- Storage ---
DB_PATH=./data/render.db
DB_BACKUP_DIR=
# Render log rows (stats, metrics) older than this are deleted.
RENDER_LOG_DAYS=30
# Versions kept per template; older ones are pruned on publish.
MAX_VERSIONS=100

# --- Callers: id:secret[:role], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: read (render), write (templates, previews), readwrite (default).
RENDER_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS,billing:REPLACE_WITH_64_HEX_CHARS:read
# Key ids that may name the acting person in an X-Actor header (the console sends the signed-in admin's username).
# Records then show that name instead of the key id. Ignored for every other key.
ACTOR_KEYS=
RATE_LIMIT_MAX=600

# --- atc-media (optional, both or neither): image blocks by file id and "store": true renders.
# The only network peer of this service. A default-role media key.
MEDIA_URL=
MEDIA_API_KEY=
MEDIA_TIMEOUT_MS=10000
# Lifetime of the signed URL returned for stored renders.
DOWNLOAD_TTL_SEC=300

# --- Limits ---
MAX_PAGES=50
# JSON-encoded size of "data" and of a layout.
MAX_DATA_BYTES=262144
MAX_LAYOUT_BYTES=131072
MAX_TABLE_ROWS=5000
# Image blocks drawn per document; bytes per image and per document (PNG or JPEG only).
MAX_IMAGES=20
MAX_IMAGE_BYTES=2097152
MAX_TOTAL_IMAGE_BYTES=10485760
MAX_PDF_BYTES=20971520
RENDER_TIMEOUT_MS=15000
# Renders at the same time; further requests answer 429 BUSY.
RENDER_CONCURRENCY=4
# Worker threads that draw the PDFs: a heavy document blocks one worker, never the HTTP loop, and a render that outlives RENDER_TIMEOUT_MS is killed. 0 = draw in the main thread.
RENDER_WORKERS=2

# --- Audit (optional): forward write and render events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-render:…:write
AUDIT_URL=
AUDIT_API_KEY=
